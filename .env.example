TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Resend — invoice email (Send to accounting)
# 1. Sign up at https://resend.com and create an API key: https://resend.com/api-keys
# 2. Set RESEND_API_KEY below
# 3. (Optional) RESEND_FROM — omit to use onboarding@resend.dev (sandbox: only delivers to your Resend account email)
# 4. For real recipients: verify your domain at https://resend.com/domains then set e.g. RESEND_FROM=Invoiced <billing@yourdomain.com>
RESEND_API_KEY=
# RESEND_FROM=

# AbacatePay — subscription billing
# 1. Create account at https://abacatepay.com and get API key
# 2. Create Starter (R$ 19,90/mo) and Pro (R$ 39,00/mo) products with MONTHLY cycle + 7-day trial
# 3. Register webhook at https://<your-domain>/api/webhooks/abacatepay?webhookSecret=<secret>
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_PRODUCT_STARTER=
ABACATEPAY_PRODUCT_PRO=
